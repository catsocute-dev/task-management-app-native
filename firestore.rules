rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the incoming request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection: Any authenticated user can read; users can only modify their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Teams collection, nested real-time chat messages, and typing indicators
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      match /typing/{userId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Team members relational mapping collection
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks collection: Authenticated users can view and manage tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
  }
}
